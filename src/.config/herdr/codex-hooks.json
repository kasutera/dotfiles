{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.codex/herdr-agent-state.sh\" session",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.codex/herdr-clear-metadata.sh\" codex-task",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
